{
  "name": "finance-cli",
  "version": "1.0.0",
  "description": "A TypeScript CLI tool to track personal finances with Prisma and Neon Postgres",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "asciichart": "^1.5.25",
    "chalk": "^4.1.2",
    "commander": "^9.4.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.11.9",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.3"
  },
  "bin": {
    "finance": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Movineo/finance-cli.git"
  },
  "keywords": [
    "finance",
    "cli",
    "budget",
    "tracker"
  ],
  "author": "Movine Odhiambo <movineee@gmail.com>",
  "license": "MIT"
}
